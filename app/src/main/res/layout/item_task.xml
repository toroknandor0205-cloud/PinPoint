<?xml version="1.0" encoding="utf-8"?>
<com.example.liquidglass.LiquidGlassView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cornerRadius="22dp"
    app:glassMaterial="regular"
    app:refractionHeight="11dp"
    app:bevelWidth="18dp"
    app:dispersionStrength="0.11"
    app:sensorHighlight="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="18dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/categoryDot"
            android:layout_width="14dp"
            android:layout_height="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/taskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/taskMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#A0A0B0"
                android:textSize="13sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/taskCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#FFFFFF" />
    </LinearLayout>
</com.example.liquidglass.LiquidGlassView>
